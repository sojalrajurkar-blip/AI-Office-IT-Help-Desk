# ==============================================================================
# AI Office IT Help Desk — Environment Configuration
# ==============================================================================

# Project
PROJECT_NAME="AI Office IT Help Desk"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
# Local: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
# Supabase: postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="your_postgres_password_here"
DB_NAME="ai_helpdesk"
DATABASE_URL="postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# JWT Authentication
# Generate a secure secret using: openssl rand -hex 32
SECRET_KEY="replace_this_with_a_super_secret_key_minimum_32_characters_long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Gemini API)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# File Storage Configuration
# 'local' for local disk uploads, 'supabase' for cloud bucket
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="uploads"

# CORS Configuration (JSON array string)
CORS_ORIGINS='["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000","*"]'
